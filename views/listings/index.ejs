<% layout('/layouts/boilerplate') -%>
    <style>
        .icon-top {
            display: flex;
            justify-content: space-between;
        }

        .icon-top p {
            font-family: "Righteous", sans-serif;
            font-size: 1.8rem;
            color: #fe424d;
            line-height: 1.5;
            margin: 0;
        }

        .tax-switch {
            font-family: sans-serif;
            font-weight: 700;
            color: aliceblue;
            border: 1px solid black;
            border-radius: 1rem;
            padding: 0.3rem 1.2rem;
            background-color: #fe424d;
        }

        .tax-info {
            display: inline;
        }
    </style>
    <div class="mb-3 mt-2 icon-top">
        <p>tripNest</p>
        <div class="tax-switch">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" value="" id="checkNativeSwitch" switch>
                <label class="form-check-label" for="checkNativeSwitch">
                    Display total after taxes
                </label>
            </div>
        </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for (list of allListing){ %>
            <a href="/listings/<%= list._id%>" class="listing-link">
                <div class="card">
                    <img src="<%= list.image.url%>" class="card-img-top" alt="..."
                        style="height: 20rem; object-fit: cover;">
                    <div class="card-img-overlay"></div> <!-- for hover effect -->
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= list.title %>
                            </b> <br>
                            &#x20B9; <span class="price" data-price="<%= list.price %>">
                                <%= list.price.toLocaleString("en-IN")%>
                            </span> / night
                            <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
                <% } %>
    </div>
    <script>
        let taxSwitch = document.getElementById("checkNativeSwitch");

        taxSwitch.addEventListener("click", () => {
            let prices = document.getElementsByClassName("price");
            let taxInfo = document.getElementsByClassName("tax-info");

            for (let i = 0; i < prices.length; i++) {
                let originalPrice = Number(prices[i].dataset.price);

                if (taxSwitch.checked) {
                    prices[i].innerText = Math.round(originalPrice * 1.18);
                    taxInfo[i].style.display = "none";
                } else {
                    prices[i].innerText = originalPrice.toLocaleString("en-IN");
                    taxInfo[i].style.display = "inline";
                }
            }
        });

    </script>